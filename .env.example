# Zugangsdaten pro Kanal. Komplett hier, NICHT in config.toml
# (config.toml ist ausschließlich das Kontaktbuch, siehe config.example.toml).
# Ein Kanal ist nur Pflicht, wenn ihn mindestens ein Kontakt in config.toml
# nutzt - siehe CONTRIBUTING.md für die Kanal-Architektur.

# --- E-Mail (Pflicht nur bei mindestens einem "email"-Kontakt) ---

# Pflichtfelder
SMTP_HOST=smtp.example.com
SMTP_FROM_ADDRESS=absender@example.com

# Optional — Defaults siehe src/channels/email.rs
SMTP_PORT=587
SMTP_ENCRYPTION=starttls
# erlaubt: starttls | tls | none
SMTP_TIMEOUT_SECS=30
SMTP_FROM_NAME=Max Mustermann

# Nur setzen, wenn der SMTP-Server Auth verlangt.
# Beide oder keine der beiden — halb gesetzt lässt den Server nicht starten.
SMTP_USERNAME=
SMTP_PASSWORD=

# --- ntfy (Pflicht nur bei mindestens einem "ntfy_topic"-Kontakt) ---
# Beide optional. Ohne NTFY_SERVER wird der öffentliche https://ntfy.sh
# genutzt, der für einfache Topics keine Auth braucht. NTFY_ACCESS_TOKEN nur
# setzen, wenn der Server/das Topic Zugriffskontrolle verlangt (z.B. eigene
# selbst gehostete Instanz).
NTFY_SERVER=https://ntfy.sh
NTFY_ACCESS_TOKEN=

# --- Telegram (Pflicht nur bei mindestens einem "telegram_chat_id"-Kontakt) ---
# Bot-Token von @BotFather. Der Bot muss vom jeweiligen Kontakt einmal
# gestartet worden sein (/start), sonst kann er ihm keine Nachricht schicken.
TELEGRAM_BOT_TOKEN=123456789:AAExampleBotTokenFromBotFather

# --- Discord (keine ENV-Variable nötig) ---
# Die Webhook-URL ist selbst das Secret und steht komplett in config.toml
# (Feld "discord_webhook_url" pro Kontakt) - siehe config.example.toml.

# Sonstige Server-Einstellungen (main.rs)
CONFIG_PATH=/app/config.toml
MCP_BIND=0.0.0.0:8080

# Pflicht. Muss vom MCP-Client als "Authorization: Bearer <token>" mitgeschickt
# werden, um POST / (den eigentlichen MCP-Endpunkt) zu erreichen. GET / bleibt
# als ungeschützter Healthcheck offen. Zum Rotieren: hier ändern und neu
# deployen — alte Clients mit dem alten Token verlieren dann den Zugriff.
MCP_BEARER_TOKEN=change-me-to-a-long-random-value
