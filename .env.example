# SMTP-Zugangsdaten und Absenderinformationen.
# Komplette SMTP-Konfiguration lebt hier, NICHT in config.toml
# (config.toml ist ausschließlich das Kontaktbuch, siehe config.example.toml).

# Pflichtfelder
SMTP_HOST=smtp.example.com
SMTP_FROM_ADDRESS=absender@example.com

# Optional — Defaults siehe src/smtp.rs
SMTP_PORT=587
SMTP_ENCRYPTION=starttls
# erlaubt: starttls | tls | none
SMTP_TIMEOUT_SECS=30
SMTP_FROM_NAME=Max Mustermann

# Nur setzen, wenn der SMTP-Server Auth verlangt.
# Beide oder keine der beiden — halb gesetzt lässt den Server nicht starten.
SMTP_USERNAME=
SMTP_PASSWORD=

# Sonstige Server-Einstellungen (main.rs)
CONFIG_PATH=/app/config.toml
MCP_BIND=0.0.0.0:8080

# Pflicht. Muss vom MCP-Client als "Authorization: Bearer <token>" mitgeschickt
# werden, um POST / (den eigentlichen MCP-Endpunkt) zu erreichen. GET / bleibt
# als ungeschützter Healthcheck offen. Zum Rotieren: hier ändern und neu
# deployen — alte Clients mit dem alten Token verlieren dann den Zugriff.
MCP_BEARER_TOKEN=change-me-to-a-long-random-value
