# Credentials per channel. All here, NOT in config.toml
# (config.toml is exclusively the contact book, see config.example.toml).
# A channel is only required if at least one contact in config.toml uses
# it - see CONTRIBUTING.md for the channel architecture.

# --- Email (required only if at least one "email" contact exists) ---

# Required fields
SMTP_HOST=smtp.example.com
SMTP_FROM_ADDRESS=sender@example.com

# Optional — defaults see src/channels/email.rs
SMTP_PORT=587
SMTP_ENCRYPTION=starttls
# allowed: starttls | tls | none
SMTP_TIMEOUT_SECS=30
SMTP_FROM_NAME=John Smith

# Only set if the SMTP server requires auth.
# Both or neither — half-set leaves the server unable to start.
SMTP_USERNAME=
SMTP_PASSWORD=

# --- ntfy (required only if at least one "ntfy_topic" contact exists) ---
# Both optional. Without NTFY_SERVER the public https://ntfy.sh is used,
# which doesn't need auth for simple topics. Only set NTFY_ACCESS_TOKEN if
# the server/topic requires access control (e.g. your own self-hosted
# instance).
NTFY_SERVER=https://ntfy.sh
NTFY_ACCESS_TOKEN=

# --- Telegram (required only if at least one "telegram_chat_id" contact exists) ---
# Bot token from @BotFather. The bot must have been started once by the
# respective contact (/start), otherwise it can't send them a message.
TELEGRAM_BOT_TOKEN=123456789:AAExampleBotTokenFromBotFather

# --- Discord (no ENV variable needed) ---
# The webhook URL is itself the secret and lives entirely in config.toml
# (field "discord_webhook_url" per contact) - see config.example.toml.

# --- Slack (no ENV variable needed) ---
# The webhook URL is itself the secret and lives entirely in config.toml
# (field "slack_webhook_url" per contact) - see config.example.toml.

# Other server settings (main.rs)
CONFIG_PATH=/app/config.toml
MCP_BIND=0.0.0.0:8080

# Required. Must be sent by the MCP client as "Authorization: Bearer <token>"
# to reach POST / (the actual MCP endpoint). GET / stays open as an
# unprotected healthcheck. To rotate: change here and redeploy — old
# clients with the old token then lose access.
MCP_BEARER_TOKEN=change-me-to-a-long-random-value
